# Copy this file to .env.local for local-only values.
# .env.local is loaded by application-local.properties and must not be committed.

# Spring Boot local profile
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8025
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_DB_UNICODE_MIGRATION_ENABLED=true

# Database
# Database
spring.datasource.url=jdbc:sqlserver://sql1004.site4now.net:1433;databaseName=db_ac9b2a_namdatabase;encrypt=true;trustServerCertificate=true
spring.datasource.username=db_ac9b2a_db_ac9b2a_namdatabase_admin
spring.datasource.password=password
spring.jpa.hibernate.ddl-auto=update

# Cloudinary file storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=agribridge

# SMTP email for registration notifications and registration OTP
APP_MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-account@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=your-smtp-account@example.com
MAIL_FROM_NAME=AgriBridge
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
