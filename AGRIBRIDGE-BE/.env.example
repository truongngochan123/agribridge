# Copy this file to .env.local for local-only values.
# .env.local is loaded by application-local.properties and must not be committed.

# Spring Boot local profile
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8025
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_DB_UNICODE_MIGRATION_ENABLED=true

# Database
DB_HOST=localhost
DB_PORT=1433
DB_NAME=agribridge
DB_USERNAME=sa
DB_PASSWORD=123456
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Cloudinary file storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=agribridge

# SMTP email for registration notifications and registration OTP
APP_MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-account@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=your-smtp-account@example.com
MAIL_FROM_NAME=AgriBridge
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
